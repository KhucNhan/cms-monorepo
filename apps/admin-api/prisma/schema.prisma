generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum VersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NOTE: `ContentType` enum REMOVED (was BLOG | PROJECT).
// Template no longer maps 1:1 to a fixed content type — a Template is now a
// standalone layout definition, sitting alongside Page rather than being a
// "kind of" Page.

// ─────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────

model Role {
  id   String @id @default(uuid())
  name String @unique  // "admin" | "editor" | "viewer"

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

/// Mỗi dòng là một quyền atomic: resource + action
/// Ví dụ: { resource: "page", action: "publish" }
model Permission {
  id       String @id @default(uuid())
  resource String // "page" | "media" | "user" | "role" | "template"
  action   String // "create" | "read" | "update" | "delete" | "publish"

  rolePermissions RolePermission[]

  @@unique([resource, action])   // không tạo duplicate permission
  @@map("permissions")
}

/// Bảng nối Role ↔ Permission (many-to-many)
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // bcrypt hash — mọi user đều có password; không có Google-only account
  roleId   String

  // Google OAuth — set lần đầu khi user đăng nhập Google, null với user chưa link
  googleId    String? @unique  // Google "sub" claim
  displayName String?          // full name từ Google profile (display only)
  avatarUrl   String?          // profile picture từ Google (display only)

  role         Role          @relation(fields: [roleId], references: [id])
  pageVersions PageVersion[]

  // Refresh token hash — không có trong DBML gốc nhưng cần cho auth
  refreshTokenHash String?

  @@map("users")
}

// ─────────────────────────────────────────────────────────
// CMS Core
// ─────────────────────────────────────────────────────────

model Page {
  id        String   @id @default(uuid())
  slug      String
  title     String   @default("")
  createdAt DateTime @default(now())

  // Template (optional) — null = static page, no template.
  // NOT NULL = this page uses the given Template's layout (placeholder blocks
  // are resolved at read-time from TemplatePlaceholder + PlaceholderOverride,
  // NOT copied into this page's own Block rows — "Cách hiểu A" design). This
  // page can still freely CRUD its OWN Block rows (the "outlet" content); it
  // can never see/edit/delete the template-owned placeholder blocks (hero,
  // footer, etc.) because those never materialize as rows belonging to it.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  // Con trỏ sang version đang live (null = chưa publish lần nào)
  publishedVersionId String?      @unique
  publishedVersion   PageVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  versions PageVersion[] @relation("PageVersions")

  // Per-page overrides for template placeholder fields explicitly marked
  // `overridableFields` in block-registry (e.g. hero.image). Only the
  // overridable subset is stored here — never a full copy of the block.
  placeholderOverrides PlaceholderOverride[]

  // Static pages (templateId IS NULL) must have a globally unique slug.
  // Pages under a template must have a unique slug WITHIN that template.
  // Postgres treats multiple NULLs in a unique index as distinct, so this
  // composite unique alone does NOT cover the templateId IS NULL case — a
  // partial unique index is added via raw SQL in the migration file.
  @@unique([templateId, slug], name: "page_template_slug_unique")
  @@map("pages")
}

model PageVersion {
  id        String        @id @default(uuid())
  status    VersionStatus @default(DRAFT)
  seoMeta   Json          @default("{}")  // { title, description, ogImage, noIndex }
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  pageId String
  page   Page @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])

  // Nghịch đảo của Page.publishedVersion
  publishedOf Page? @relation("PublishedVersion")

  blocks Block[]

  @@index([pageId, status])
  @@map("page_versions")
}

model Block {
  id         String   @id @default(uuid())
  type       String   // khớp key trong block-registry: "hero" | "rich-text" | "faq"
  orderIndex Int
  data       Json     // validated bằng Zod từ block-registry trước khi write
  updatedAt  DateTime @updatedAt

  pageVersionId String
  pageVersion   PageVersion @relation(fields: [pageVersionId], references: [id], onDelete: Cascade)

  @@index([pageVersionId, orderIndex])
  @@map("blocks")
}

// ─────────────────────────────────────────────────────────
// Templates
// ─────────────────────────────────────────────────────────

/// Template = một layout độc lập, KHÔNG phải "loại Page". Page trỏ tới Template
/// qua Page.templateId (nullable) thay vì Template sở hữu Page.
///
/// slugPrefix được HỆ THỐNG TỰ SINH khi tạo Template — không cho admin nhập tay:
///   slugPrefix = lowercase(name) + "s"   (vd name="Project" -> slugPrefix="projects")
/// Dùng cho route công khai 2 cấp: /{slugPrefix}/{page.slug}  (vd /projects/agas)
/// slugPrefix BẤT BIẾN sau khi tạo — sửa name không đổi slugPrefix (tránh gãy URL cũ).
model Template {
  id         String   @id @default(uuid())
  name       String
  slugPrefix String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  placeholders TemplatePlaceholder[]
  pages        Page[]

  @@map("templates")
}

/// Khai báo "layout này có 1 block loại X ở vị trí Y" — KHÔNG lưu data thật.
/// Data thật được resolve tại read-time cho từng Page bằng:
///   block-registry.defaultData  (ảnh mặc định, v.v.)
///   + autoFillMap                (field lấy tự động từ Page, vd title)
///   + PlaceholderOverride.data   (field admin tự sửa riêng theo từng page, vd ảnh Hero)
/// Field nào được phép override do `getBlockDefinition(type).overridableFields`
/// ở block-registry quyết định — KHÔNG lưu cột `editableFields` song song ở đây.
model TemplatePlaceholder {
  id         String @id @default(uuid())
  type       String // "hero" | "faq" | "next-project" | ... — khớp block-registry type
  orderIndex Int

  /// vd: { "title": "page.title" } — key = field path trong block.data,
  /// value = nguồn dữ liệu ("page.title" | "page.slug" | ...).
  autoFillMap Json?

  updatedAt DateTime @updatedAt

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  overrides PlaceholderOverride[]

  @@index([templateId, orderIndex])
  @@map("template_placeholders")
}

/// Override tối giản theo từng Page cho 1 placeholder cụ thể — CHỈ chứa các
/// field nằm trong `overridableFields` của block-registry (vd ảnh Hero).
/// Xóa TemplatePlaceholder ở Template => cascade xóa toàn bộ override liên
/// quan — TemplatesService PHẢI đếm/liệt kê ảnh hưởng và xin xác nhận admin
/// TRƯỚC khi xóa placeholder, không xóa âm thầm.
model PlaceholderOverride {
  id        String   @id @default(uuid())
  data      Json     @default("{}") // vd { "image": { "mediaId": "...", "url": "..." } }
  updatedAt DateTime @updatedAt

  pageId String
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  placeholderId String
  placeholder   TemplatePlaceholder @relation(fields: [placeholderId], references: [id], onDelete: Cascade)

  @@unique([pageId, placeholderId])
  @@map("placeholder_overrides")
}

// ─────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────

model Media {
  id       String @id @default(uuid())
  url      String
  key      String @unique   // object key trên S3/R2/local
  mimeType String

  detailKey String?
  detailUrl String?
  thumbKey  String?
  thumbUrl  String?

  width  Int?
  height Int?

  altText  String? // alt text cho SEO / accessibility
  fileSize Int?    // kích thước file gốc user upload (bytes) — null với record cũ trước tính năng này

  @@map("media")
}
